<Project Sdk="Microsoft.NET.Sdk">

  <!--
    In-process login-latency benchmark for the OpenID challenge and callback (#1117), the measuring
    instrument for the pre-RC login-path characterization (#742). It is DELIBERATELY NOT part of
    SSO-Auth.sln, the same way SSO-Auth.Fuzz is: a normal `dotnet build`/`dotnet test`, the coverage
    gate and the vulnerable-dependency scan all work from the solution, so they never restore or
    build this project and their timings are unaffected by it. Nothing in CI runs it either - it is a
    characterization, not a gate, so it carries no pass/fail threshold (see README.md).

    It drives the real SSOController in-process against the test project's SsoControllerHarness and
    OidcTokenFixture rather than a copy of them: of the two routes #1117 allows (lift the harness
    construction in here, or reference the test project and open its internals), the reference is the
    one that cannot drift. A lifted copy would keep measuring the harness as it was on the day it was
    copied, which is the wrong instrument the moment the login path's setup changes. The cost is that
    building this project also builds SSO-Auth.Tests; that cost is paid here and nowhere else,
    because nothing else references this project.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Run on a newer major runtime when the exact 9.0 pack is absent (the test and fuzz projects
         do the same), so the harness launches on a box that only ships the .NET 10 runtime. -->
    <RollForward>Major</RollForward>
    <RootNamespace>Jellyfin.Plugin.SSO_Auth.Bench</RootNamespace>
    <AssemblyName>SSO-Auth.Bench</AssemblyName>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- No CS1591 doc-comment gate on a non-shipping harness (matches the test and fuzz projects). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- xunit.v3's targets reach this project through the test-project reference (they ship under
         buildTransitive) and would inject their own generated Main, which wins over Program.Main and
         breaks the build with CS8892. This is xunit's own switch for a non-test executable. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project owns SsoControllerHarness (the mocked-Jellyfin SSOController) and
         OidcTokenFixture (a self-consistent signing IdP served through the stub HTTP handler). Both
         are internal to that assembly and reachable here only through the InternalsVisibleTo in
         SSO-Auth.Tests/AssemblyInfo.cs. This reference also brings SSO-Auth itself. -->
    <ProjectReference Include="..\SSO-Auth.Tests\SSO-Auth.Tests.csproj" />
  </ItemGroup>

</Project>
