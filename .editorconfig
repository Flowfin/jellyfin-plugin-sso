# Analyzer configuration. Replaces the legacy jellyfin.ruleset (same
# severities, migrated 1:1). The fail-closed security posture lives in the
# csproj files (AnalysisModeSecurity=All enables every Security rule;
# CodeAnalysisTreatWarningsAsErrors makes analyzer findings fail EVERY build)
# because the analysis mode's per-rule severities outrank any category-bulk
# entry here. The bulk entry below stays as a belt for rules the mode configs
# do not pin.
root = true

[*.cs]

# --- Security rules are errors (fail closed; see csproj note above) --------
dotnet_analyzer_diagnostic.category-Security.severity = error

# --- Migrated from jellyfin.ruleset: StyleCop ------------------------------
# Demoted to suggestion (deliberate helper-near-caller grouping and repo style).
dotnet_diagnostic.SA1202.severity = suggestion
dotnet_diagnostic.SA1204.severity = suggestion
dotnet_diagnostic.SA1404.severity = suggestion
# Disabled repo-wide.
dotnet_diagnostic.SA1009.severity = none
dotnet_diagnostic.SA1101.severity = none
dotnet_diagnostic.SA1108.severity = none
dotnet_diagnostic.SA1128.severity = none
dotnet_diagnostic.SA1130.severity = none
dotnet_diagnostic.SA1200.severity = none
dotnet_diagnostic.SA1309.severity = none
dotnet_diagnostic.SA1402.severity = none
dotnet_diagnostic.SA1413.severity = none
dotnet_diagnostic.SA1512.severity = none
dotnet_diagnostic.SA1515.severity = none
dotnet_diagnostic.SA1600.severity = warning
# A copied summary and a sentence without its period are refused (#1887),
# because the comment charter asks for one sentence per member.
dotnet_diagnostic.SA1625.severity = warning
dotnet_diagnostic.SA1629.severity = warning
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1649.severity = none

# --- Analyzer-adoption backlog (issue #101 follow-up) -----------------------
# Non-security rules newly surfaced by AnalysisMode Recommended + Roslynator +
# Meziantou. Demoted to suggestion so the security net lands green; each family
# is worked through deliberately in follow-ups (several are behavior-relevant
# on the login path - string-comparison semantics must not change in a config
# PR).
dotnet_diagnostic.CA1309.severity = error
dotnet_diagnostic.CA1311.severity = suggestion
dotnet_diagnostic.MA0002.severity = suggestion
dotnet_diagnostic.MA0006.severity = error
dotnet_diagnostic.MA0011.severity = suggestion
dotnet_diagnostic.MA0015.severity = suggestion
dotnet_diagnostic.MA0074.severity = suggestion
dotnet_diagnostic.MA0158.severity = suggestion
# HIGH-priority backlog: culture-dependent casing/comparison on the identity
# path (AddCanonicalLink ToLower, WebResponse IndexOf). Fixing changes the
# canonical-link keys of existing installations, so it needs its own reviewed
# PR with a migration consideration - not a ride-along in a config change.
dotnet_diagnostic.CA1304.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
# The SSO_Auth namespace underscore is load-bearing: renaming breaks users'
# persisted AuthenticationProviderId (same rationale as the accepted S101).
dotnet_diagnostic.CA1707.severity = none

# --- Accept-with-reason dispositions (issue #104) --------------------------
# Families reviewed and deliberately accepted: fixing them is noise or
# negative-value on this plugin. Disabled repo-wide (not left as a suggestion)
# so they no longer surface, mirroring the SA1402=none / SA1649=none / CA1707
# accepts above. Each carries the reason it was declined.
# CA1848 (use LoggerMessage delegates): plugin log volume is trivial; 51 call
# sites across every hot login/security file for negligible runtime benefit.
# Per issue #104's own lean.
dotnet_diagnostic.CA1848.severity = none
# MA0048 (file name must match type name): deliberate helper-near-caller
# co-location; consistent with the existing SA1402=none / SA1649=none decision.
dotnet_diagnostic.MA0048.severity = none
# MA0008 (add StructLayoutAttribute): meaningless for managed record struct
# value types with reference fields; these are not interop types.
dotnet_diagnostic.MA0008.severity = none
# RCS1194 + CA1032 (implement standard exception constructors): internal sealed
# exceptions with deliberately narrow constructors and generic messages; the
# extra public constructors are unused noise.
dotnet_diagnostic.RCS1194.severity = none
dotnet_diagnostic.CA1032.severity = none
# MA0016 (prefer collection abstraction over List): PluginConfiguration.Folders
# is a serialized config DTO; changing its type risks persisted-config
# serialization compatibility.
dotnet_diagnostic.MA0016.severity = none
# MA0051 (method is too long): splitting login-path methods (Oidc/SamlLogin
# Service, CanonicalLinkService) is behavior-relevant refactoring on the auth
# path for zero functional or security gain.
dotnet_diagnostic.MA0051.severity = none

# --- Migrated from jellyfin.ruleset: CA ------------------------------------
# CA1031 is on (#1887). The boundary handlers that swallow every exception on
# purpose are listed by name; #1903 shrinks this list to zero. A new
# catch (Exception) anywhere else fails the build.
dotnet_diagnostic.CA1031.severity = warning
dotnet_code_quality.CA1031.excluded_symbol_names = M:Jellyfin.Plugin.SSO_Auth.Api.Avatar.AvatarService.TrySetAsync(Jellyfin.Database.Implementations.Entities.User,Jellyfin.Plugin.SSO_Auth.Api.Avatar.AvatarTarget)|M:Jellyfin.Plugin.SSO_Auth.Api.Events.SsoLoginEvents.PublishDeniedAsync(System.String,System.String,System.String)|M:Jellyfin.Plugin.SSO_Auth.Api.Flows.LoginCompletionService.CaptureLogoutState(Jellyfin.Plugin.SSO_Auth.Api.Identity.VerifiedIdentity,System.Guid,System.Nullable{Jellyfin.Plugin.SSO_Auth.Api.Logout.LogoutContext},MediaBrowser.Controller.Authentication.AuthenticationResult)|M:Jellyfin.Plugin.SSO_Auth.Api.Http.PluginPageCacheFilter.OnResultExecuting(Microsoft.AspNetCore.Mvc.Filters.ResultExecutingContext)|M:Jellyfin.Plugin.SSO_Auth.Api.Http.SSOController.OidBackChannelLogout(System.String,System.String)|M:Jellyfin.Plugin.SSO_Auth.Api.Http.SSOController.OidLogout(System.String,System.String)|M:Jellyfin.Plugin.SSO_Auth.Api.Http.SSOController.PurgeProviderLinks(System.String,System.String,System.Int32)|M:Jellyfin.Plugin.SSO_Auth.Api.Http.SSOController.SamlLogout(System.String,System.String,System.String)|M:Jellyfin.Plugin.SSO_Auth.Api.Linking.CanonicalLinkService.ClearPendingApprovalAfterLogin(Jellyfin.Plugin.SSO_Auth.Api.Provider.ProviderMode,System.String,System.String)|M:Jellyfin.Plugin.SSO_Auth.Api.Linking.CanonicalLinkService.RecordLastSsoLogin(Jellyfin.Plugin.SSO_Auth.Api.Provider.ProviderMode,System.String,System.String)|M:Jellyfin.Plugin.SSO_Auth.Api.Linking.CanonicalLinkService.SeedHomeScreen(System.Guid,System.String,Jellyfin.Plugin.SSO_Auth.Config.ProvisioningPolicyTemplate)|M:Jellyfin.Plugin.SSO_Auth.Api.Linking.CanonicalLinkService.SyncUsernameIfRequestedAsync(System.Boolean,Jellyfin.Plugin.SSO_Auth.Api.Provider.ProviderMode,System.String,System.Guid,System.String)|M:Jellyfin.Plugin.SSO_Auth.Api.Linking.DeletedAccountLinkPruner.OnEvent(Jellyfin.Data.Events.Users.UserDeletedEventArgs)|M:Jellyfin.Plugin.SSO_Auth.Api.LoginButtons.LoginButtonManager.StartAsync(System.Threading.CancellationToken)|M:Jellyfin.Plugin.SSO_Auth.Api.LoginButtons.LoginButtonManager.Sync(Jellyfin.Plugin.SSO_Auth.Config.PluginConfiguration)|M:Jellyfin.Plugin.SSO_Auth.Api.Oidc.OidcDiscoveryReader.ReadAsync(Duende.IdentityModel.OidcClient.OidcClientOptions,System.String,System.Net.Http.IHttpClientFactory,Microsoft.Extensions.Logging.ILogger,System.Boolean,System.Threading.CancellationToken)|M:Jellyfin.Plugin.SSO_Auth.Api.Session.AccountExpirySweepService.TickAsync|M:Jellyfin.Plugin.SSO_Auth.Api.Session.PasswordlessLinkedAccountSweepService.StartAsync(System.Threading.CancellationToken)|M:Jellyfin.Plugin.SSO_Auth.Api.Session.SsoOnlyReconciliationService.StartAsync(System.Threading.CancellationToken)|M:Jellyfin.Plugin.SSO_Auth.Api.Shared.ChallengeNewPathResolver.ResolveChallengeNewPath``1(System.String,``0,System.Boolean,Microsoft.AspNetCore.Http.HttpRequest,Microsoft.Extensions.Logging.ILogger,System.Func{Jellyfin.Plugin.SSO_Auth.Config.PluginConfiguration,Jellyfin.Plugin.SSO_Auth.Config.SerializableDictionary{System.String,``0}})
# CA1062 guards the public surface only (#1887); the internal surface is
# covered by nullable reference types. The one public action that passes a
# route value on unchecked is named here until #1891 reads it.
dotnet_diagnostic.CA1062.severity = warning
dotnet_code_quality.CA1062.api_surface = public
dotnet_code_quality.CA1062.excluded_symbol_names = M:Jellyfin.Plugin.SSO_Auth.Api.Http.SSOController.OidCallback(System.String,System.String)
# Demoted to suggestion.
dotnet_diagnostic.CA1716.severity = suggestion
dotnet_diagnostic.CA1720.severity = suggestion
dotnet_diagnostic.CA1812.severity = suggestion
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA2000.severity = suggestion
# Disabled repo-wide.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1308.severity = none

[SSO-Auth.Tests/**.cs]
# Inline constant arrays keep test cases readable; the standing decision for
# test code (documented-accepted) applies here too.
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1825.severity = none
# Test helpers take their arguments from the test itself; a null there is a
# failing test, not a public contract (#1887).
dotnet_diagnostic.CA1062.severity = none

[SSO-Auth.Fuzz/**.cs]
# A fuzz harness catches everything so that one input cannot end the run;
# the exception is the finding it reports (#1887).
dotnet_diagnostic.CA1031.severity = none
